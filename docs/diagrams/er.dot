digraph G { rankdir=LR; fontname="Helvetica"; node [shape=plain, fontname="Helvetica", fontsize=10];
 students [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#1e3a8a"><FONT COLOR="white"><B>students</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK id</B></TD></TR><TR><TD ALIGN="LEFT">student_id (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">name, email (UNIQUE), phone</TD></TR><TR><TD ALIGN="LEFT">department, year</TD></TR><TR><TD ALIGN="LEFT">hostel_block, room_no</TD></TR><TR><TD ALIGN="LEFT">parent_phone</TD></TR><TR><TD ALIGN="LEFT">password_hash, created_at</TD></TR></TABLE>>];
 wardens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#0d9488"><FONT COLOR="white"><B>wardens</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK id</B></TD></TR><TR><TD ALIGN="LEFT">username (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">name, designation, phone</TD></TR><TR><TD ALIGN="LEFT">password_hash, created_at</TD></TR></TABLE>>];
 req [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#b45309"><FONT COLOR="white"><B>outpass_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK id</B></TD></TR><TR><TD ALIGN="LEFT"><I>FK student_pk -&gt; students.id</I></TD></TR><TR><TD ALIGN="LEFT"><I>FK warden_pk -&gt; wardens.id</I></TD></TR><TR><TD ALIGN="LEFT">outpass_no (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">original_text, category, confidence</TD></TR><TR><TD ALIGN="LEFT">destination, departure_date</TD></TR><TR><TD ALIGN="LEFT">departure_time, return_time</TD></TR><TR><TD ALIGN="LEFT">priority, nlp_json</TD></TR><TR><TD ALIGN="LEFT">status (Pending/Approved/Rejected)</TD></TR><TR><TD ALIGN="LEFT">warden_remarks, decided_at, created_at</TD></TR></TABLE>>];
 hist [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#475569"><FONT COLOR="white"><B>approval_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK id</B></TD></TR><TR><TD ALIGN="LEFT"><I>FK request_id -&gt; outpass_requests.id</I></TD></TR><TR><TD ALIGN="LEFT">action, actor_role, actor_name</TD></TR><TR><TD ALIGN="LEFT">remarks, created_at</TD></TR></TABLE>>];
 students -> req [label="1 : N  submits", arrowhead=crow]; wardens -> req [label="1 : N  decides", arrowhead=crow]; req -> hist [label="1 : N  logs", arrowhead=crow]; }
