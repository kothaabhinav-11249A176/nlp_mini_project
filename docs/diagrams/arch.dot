digraph G { rankdir=LR; fontname="Helvetica"; node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#dbeafe", color="#1e3a8a"]; edge [fontname="Helvetica", fontsize=9];
 subgraph cluster_c { label="Presentation Layer (Browser)"; style=dashed; Stu [label="Student UI\nHTML/CSS/JS + Bootstrap"]; War [label="Warden UI\nHTML/CSS/JS + Bootstrap"]; }
 subgraph cluster_s { label="Application Layer (Flask - app.py)"; style=dashed; Auth [label="Auth & Sessions\nRBAC, CSRF"]; Routes [label="Routes / Controllers\n+ Validation"]; PDF [label="PDF + QR\nReportLab, qrcode"]; }
 subgraph cluster_n { label="NLP Layer (nlp_processing.py)"; style=dashed; Pre [label="Preprocess\nTokenize\nStop-words", fillcolor="#ccfbf1"]; ML [label="Reason Classifier\nTF-IDF + Naive Bayes", fillcolor="#ccfbf1"]; Ext [label="Rule-based Extractors\nDate, Time, Destination", fillcolor="#ccfbf1"]; }
 subgraph cluster_d { label="Data Layer (database.py)"; style=dashed; DB [label="SQLite\nstudents, wardens,\noutpass_requests,\napproval_history", shape=cylinder, fillcolor="#fef3c7"]; Model [label="reason_model.joblib\ntraining_data.csv", shape=note, fillcolor="#fef3c7"]; }
 Stu -> Auth [label="HTTP"]; War -> Auth; Auth -> Routes; Routes -> Pre [label="request text"]; Pre -> ML; Pre -> Ext; ML -> Routes [label="category"]; Ext -> Routes [label="structured data"]; Routes -> DB [label="parameterised SQL"]; Routes -> PDF; PDF -> Stu [label="outpass.pdf"]; ML -> Model [dir=both]; }
