digraph G { rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=9];
 S [label="Student", shape=box, style=filled, fillcolor="#dbeafe"]; W [label="Warden", shape=box, style=filled, fillcolor="#dbeafe"]; G [label="Gate Security", shape=box, style=filled, fillcolor="#dbeafe"];
 P1 [label="1.0\nAuthenticate", shape=ellipse, style=filled, fillcolor="#ecfccb"]; P2 [label="2.0\nNLP Analyse\nRequest", shape=ellipse, style=filled, fillcolor="#ccfbf1"]; P3 [label="3.0\nStore & Track\nRequest", shape=ellipse, style=filled, fillcolor="#ecfccb"]; P4 [label="4.0\nReview &\nDecide", shape=ellipse, style=filled, fillcolor="#ecfccb"]; P5 [label="5.0\nGenerate Outpass\nPDF + QR", shape=ellipse, style=filled, fillcolor="#ecfccb"]; P6 [label="6.0\nVerify QR", shape=ellipse, style=filled, fillcolor="#ecfccb"];
 D1 [label="D1 Students / Wardens", shape=cds, style=filled, fillcolor="#fef3c7"]; D2 [label="D2 Outpass Requests", shape=cds, style=filled, fillcolor="#fef3c7"]; D3 [label="D3 Approval History", shape=cds, style=filled, fillcolor="#fef3c7"];
 S -> P1 [label="credentials"]; W -> P1 [label="credentials"]; P1 -> D1 [dir=both]; S -> P2 [label="natural-language\nmessage"]; P2 -> S [label="extracted fields\n+ missing info"]; S -> P3 [label="confirmed application"]; P3 -> D2; P3 -> D3; D2 -> P4 [label="pending requests"]; W -> P4 [label="approve / reject\n+ remarks"]; P4 -> D2 [label="status"]; P4 -> D3; D2 -> P5 [label="approved data"]; P5 -> S [label="outpass PDF"]; G -> P6 [label="scan QR"]; D2 -> P6; P6 -> G [label="valid / invalid"]; }
